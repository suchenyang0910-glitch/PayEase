{
  "name": "@payease/broker-api",
  "version": "0.1.0-v1-local",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "PayEase controlled-pilot Broker API. Local PostgreSQL only; no external integrations.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "preflight:telegram-auth": "node dist/deployment-preflight.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --exclude __tests__/public-application.integration.test.ts",
    "test:integration": "node scripts/require-integration-database.mjs && vitest run __tests__/public-application.integration.test.ts",
    "lint": "echo 'broker-api lint placeholder'"
  },
  "dependencies": {
    "@payease/v1-domain": "workspace:*",
    "fastify": "^5.3.0",
    "pg": "^8.14.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
